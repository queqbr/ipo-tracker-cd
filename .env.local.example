# Copy this file to .env.local (gitignored, never commit real URLs) and
# fill in real values. npm run refresh / npm run probe load it automatically.

OPENAI_API_KEY=sk-...

# One entry per exchange code used in scripts/sources.js. A url containing
# the literal string {{YEAR}} has that replaced with the current year at
# load time (used by B3's CVM query). Single-quoted so the embedded double
# quotes in the JSON don't need escaping.
SOURCE_URLS_JSON='{"LSE":"https://example.com/lse-new-issues","WSE":"https://example.com/wse-new-listings","XETRA":"https://example.com/xetra-new-issues","DFM":"https://example.com/dfm-announcements","TWSE":"https://example.com/twse-new-listing","SET":"https://example.com/set-upcoming-ipo","TADAWUL":"https://example.com/tadawul-ipos","SGX":"https://example.com/sgx-announcements","KLSE":"https://example.com/klse-ipo-summary","JSE":"https://example.com/jse-sens","B3":"https://example.com/cvm-registry?year={{YEAR}}"}'
